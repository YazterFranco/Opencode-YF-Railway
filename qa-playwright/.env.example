# Entorno activo: dev | qa | staging | prod
ENV=qa

# Secretos (NO versionar valores reales; se inyectan en CI)
API_TOKEN=
WEB_USER=
WEB_PASS=

# BrowserStack (App Automate)
BROWSERSTACK_USER=
BROWSERSTACK_KEY=
BS_APP=bs://<app-id>
BS_PROJECT=QA-Mobile
BS_BUILD=local
BS_CDP_URL=

# Webview / CDP: local (adb) | browserstack | appium
WEBVIEW_MODE=local
WEBVIEW_CDP_URL=http://127.0.0.1:9222
