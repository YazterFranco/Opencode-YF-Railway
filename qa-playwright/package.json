{
  "name": "qa-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma QA con Playwright: Web + API + Mobile WebView (CDP/BrowserStack)",
  "engines": { "node": ">=18.0.0" },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "lint": "eslint . && tsc --noEmit && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "validate:env": "tsx scripts/validate-env.ts",
    "test": "playwright test",
    "test:web": "playwright test tests/web",
    "test:api": "playwright test tests/api",
    "test:mobile": "playwright test tests/mobile",
    "test:smoke": "playwright test --grep @smoke",
    "test:parallel": "playwright test --workers=4",
    "report": "playwright show-report reports/html"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.0",
    "dotenv": "^16.4.0",
    "eslint": "^9.0.0",
    "eslint-plugin-playwright": "^2.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  },
  "dependencies": {
    "undici": "^6.20.0"
  }
}
